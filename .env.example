# Production: copy to .env.production on the server (same keys).
# Supabase Dashboard → Auth: Site URL + Redirect URLs dùng https://nntads.live
#
# CMS cùng app: /cms/dashboard — Supabase Redirect URLs cần có .../cms/reset-password
#
# Log (lib/logger.ts): debug | info | warn | error
# LOG_LEVEL=info                    # server (SSR, API, …)
# NEXT_PUBLIC_LOG_LEVEL=warn        # browser — mặc định prod=warn, dev=debug nếu không set
#
# Tuỳ chọn: ghi đè URL canonical (mặc định app dùng https://nntads.live).
# NEXT_PUBLIC_SITE_URL=https://nntads.live
#
# Nhiều site trên cùng VPS: mỗi app một PORT khác nhau (vd 3010), và sửa Nginx proxy_pass cho đúng port.
# PORT=3010
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
